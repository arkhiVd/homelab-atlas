#!/usr/bin/env bash
set -euo pipefail
cd "$(dirname "$0")/.."
python -m ruff format --check .
python -m ruff check .
python -m pytest -q
python -m atlas.cli verify
rm -rf out
python -m atlas.cli render
first="$(sha256sum out/atlas.html)"
python -m atlas.cli render
second="$(sha256sum out/atlas.html)"
test "$first" = "$second"
git diff --check
git diff --cached --check
empty_tree="$(git hash-object -t tree /dev/null)"
git diff --check "$empty_tree" HEAD -- . ':(exclude)vendor/mermaid.min.js'
printf 'PASS: format, lint, tests, fixture drift, render idempotency, whitespace checks\n'
