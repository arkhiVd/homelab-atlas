#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
ruff format --check .
ruff check .
pytest -q
bin/render-artifact >/tmp/atlas-render-first.log
first=$(sha256sum out/site/index.html)
bin/render-artifact >/tmp/atlas-render-second.log
second=$(sha256sum out/site/index.html)
[[ "$first" == "$second" ]]
git diff --check -- . ':(exclude)vendor/mermaid.min.js'
printf 'PASS: format, lint, tests, deterministic render, whitespace checks\n'
