#!/usr/bin/env bash
set -euo pipefail
ROOT=$(cd "$(dirname "$0")/.." && pwd)
cd "$ROOT"
ruff format --check .
ruff check .
pytest -q
bin/render-artifact >/tmp/atlas-render-first.log
python3 - <<'PY'
import re
import subprocess
from pathlib import Path
page = Path("out/site/index.html").read_text()
scripts = re.findall(r"<script(?:[^>]*)>(.*?)</script>", page, re.DOTALL)
if not scripts:
    raise SystemExit("no generated inline scripts")
for index, script in enumerate(scripts):
    path = Path(f"/tmp/atlas-inline-{index}.js")
    path.write_text(script)
    subprocess.run(["node", "--check", path], check=True)
PY
first=$(sha256sum out/site/index.html)
bin/render-artifact >/tmp/atlas-render-second.log
second=$(sha256sum out/site/index.html)
[[ "$first" == "$second" ]]
git diff --check -- . ':(exclude)vendor/mermaid.min.js'
printf 'PASS: format, lint, tests, deterministic render, whitespace checks\n'
