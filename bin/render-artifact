def build(docs: list[dict], evidence: dict, now: datetime | None = None) -> str:
    stale = is_stale(evidence, now)
    identities = load_identity_assets()
    meta = json.dumps(
        {key: value for key, value in evidence.items() if key not in {"stats", "reused"}},
        separators=(",", ":"),
    )
    stat_html = "".join(
        f'<div class="atlas-stat atlas-{esc(state)}"><b>{esc(value)}</b><span>{esc(label)}</span></div>'
        for value, label, state in evidence["stats"]
    )
    rail = "".join(
        f'<li><a href="#{esc(doc["anchor"])}" data-target="{esc(doc["anchor"])}">{esc(doc["title"].split(" — ")[0])}</a></li>'
        for doc in docs
    )
    cards = []
    for doc in docs:
        heading, _, sub = doc["title"].partition(" — ")
        diagram_name = f"{heading}{': ' + sub if sub else ''}"

        def participant_assets(body: str) -> str:
            pairs = re.findall(
                r"^\s*%% atlas-participant (\w+) ([a-z0-9-]+)\s*$", body, re.MULTILINE
            )
            assets = {
                participant: identities[f"runbook-{token}"]["url"]
                for participant, token in pairs
                if f"runbook-{token}" in identities
            }
            return esc(json.dumps(assets, separators=(",", ":"))) if assets else ""

        bodies = "".join(
            f'{f"<h3>{esc(topic)}</h3>" if topic else ""}<div class="atlas-sheet atlas-diagram-theme{" atlas-sequence-sheet atlas-sequence-theme" if "sequenceDiagram" in body else ""}" data-atlas-source="{esc(body)}" data-atlas-participants="{participant_assets(body)}"><div class="atlas-sheet-toolbar"><button class="atlas-zoom" type="button" aria-label="Zoom {esc(diagram_name)}{": " + esc(topic) if topic else ""}">zoom</button></div><div class="atlas-viewport"><pre class="mermaid">{esc(body)}</pre></div></div>'
            for topic, body in doc["bodies"]
        )
        note_items = "".join(f"<li>{esc(note)}</li>" for note in doc["notes"])
        screenshots = doc.get("screenshots", [])
        note_images = "".join(
            f'<figure><img src="{esc(item["src"])}" alt="{esc(item["alt"])}" loading="lazy"><figcaption>{esc(item["caption"])}</figcaption></figure>'
            for item in screenshots
        )
        notes = (
            f'<section class="atlas-notes" aria-label="Notes"><h3>Notes</h3><ul>{note_items}</ul>{note_images}</section>'
            if doc["notes"] or screenshots
            else ""
        )
        links = RESOURCE_LINKS.get(doc["id"], [])
        resources = (
            ""
            if not links
            else '<p class="atlas-resources"><strong>Sources:</strong> '
            + " · ".join(f'<a href="{esc(url)}">{esc(label)}</a>' for label, url in links)
            + "</p>"
        )
        cards.append(
            f'<section class="atlas-diagram" id="{esc(doc["anchor"])}" data-layer="{esc(doc["layer"])}" data-stack="{esc(doc["stack_key"])}"><p>{esc(doc["id"])} · {esc(doc["stack"])}</p><h2>{esc(heading)}</h2><p>{esc(sub)}</p><p>{esc(doc["summary"])}</p>{resources}{bodies}{notes}</section>'
        )
    overview = "A self-hosted environment organized around authenticated remote access, containerized applications, synchronized storage, automation, observability, and agent-assisted workflows. Follow the diagrams from system context to individual application pipelines to see which clients open each dashboard, which services exchange data, and where durable state is kept."
    return (
        f"""<title>Public Architecture Atlas</title><style>
#atlas-root{{--atlas-ink:#ededf0;--atlas-soft:#9b9ba3;--atlas-ground:#050507;--atlas-panel:#0f1218;--atlas-line:rgba(255,255,255,.32);--atlas-accent:#4fc1d4;--atlas-accent-dim:rgba(79,193,212,.14);--atlas-sheet:#101722;--atlas-warn:#ffce6e;font:17px/1.65 'Instrument Sans',system-ui,sans-serif;color:var(--atlas-ink);background:transparent;max-width:1400px;margin:auto;padding:0 clamp(24px,5vw,72px);position:relative;z-index:1}}#atlas-root *,#atlas-root *::before,#atlas-root *::after{{box-sizing:border-box}}#atlas-root button,#atlas-root input,#atlas-root select{{font:inherit}}#atlas-root button{{cursor:pointer;min-height:44px}}#atlas-root a{{color:var(--atlas-accent)}}#atlas-root .atlas-skip{{position:fixed;left:1rem;top:1rem;z-index:50;transform:translateY(-200%);padding:.5rem .75rem;background:var(--atlas-panel);color:var(--atlas-accent);border:1px solid var(--atlas-accent);border-radius:8px}}#atlas-root .atlas-skip:focus{{transform:none}}#atlas-root .atlas-grid{{display:grid;grid-template-columns:16rem minmax(0,1fr);gap:0 3rem}}#atlas-root .atlas-head,#atlas-root .atlas-footer{{grid-column:1/-1}}#atlas-root h1,#atlas-root h2,#atlas-root h3{{line-height:1.15;font-weight:500}}#atlas-root .atlas-meta,#atlas-root dt{{font:13px 'JetBrains Mono',ui-monospace,monospace;color:var(--atlas-soft);letter-spacing:.02em}}#atlas-root .atlas-head{{padding:72px 0 32px;border-bottom:1px solid var(--atlas-line)}}#atlas-root .atlas-head h1{{font-size:clamp(34px,5vw,56px);letter-spacing:-.02em;margin:12px 0}}.atlas-head>p:last-child{{max-width:74ch;margin:0;color:var(--atlas-soft)}}#atlas-root .atlas-rail{{grid-column:1;position:sticky;top:0;align-self:start;max-height:100vh;overflow:auto;padding:32px 0}}#atlas-root .atlas-rail ul{{list-style:none;margin:0;padding:0}}#atlas-root .atlas-rail a{{display:block;border-left:2px solid transparent;padding:.5rem .75rem;color:var(--atlas-soft);text-decoration:none;font-size:.84rem}}#atlas-root .atlas-rail a:hover,#atlas-root .atlas-rail a:focus