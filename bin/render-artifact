DASHBOARD_SCRIPT = r"""<script>
(function(){var root=document.getElementById('atlas-root');if(!root)return;var q=function(s){return root.querySelector(s)},qa=function(s){return[].slice.call(root.querySelectorAll(s))};function decorateParticipants(){qa('.mermaid[data-atlas-participants]').forEach(function(host){var sheet=host.closest('.atlas-sheet'),svg=host.matches('svg')?host:host.querySelector('svg')||(sheet&&sheet.querySelector('svg'));if(!svg||svg.dataset.atlasDecorated)return;var assets;try{assets=JSON.parse(host.dataset.atlasParticipants||'{}')}catch(e){return}Object.keys(assets).forEach(function(id){svg.querySelectorAll('rect.actor[name="'+id+'"]').forEach(function(rect){var x=+rect.getAttribute('x'),y=+rect.getAttribute('y'),w=+rect.getAttribute('width'),image=document.createElementNS('http://www.w3.org/2000/svg','image');image.setAttribute('href','./assets/14-runbooks/14-runbooks-'+assets[id]+'.svg');image.setAttribute('x',String(x+(w-52)/2));image.setAttribute('y',String(y+1));image.setAttribute('width','52');image.setAttribute('height','52');svg.appendChild(image)})});svg.dataset.atlasDecorated='true'})}document.addEventListener('atlas:mermaid-rendered',decorateParticipants);var zoom=q('#atlas-zoom'),content=q('#atlas-zoom-content'),scale=1.75;function setZoom(v){scale=Math.max(.2,Math.min(4,v));content.style.setProperty('--atlas-zoom-scale',scale);var b=q('[data-zoom-action="reset"]');if(b)b.textContent=Math.round(scale*100)+'%'}function open(sheet){var source=sheet.querySelector('svg,pre');if(!source)return;content.replaceChildren(source.cloneNode(true));setZoom(1.75);zoom.showModal()}qa('.atlas-zoom').forEach(function(b){b.addEventListener('click',function(e){e.stopPropagation();open(b.parentElement)})});qa('[data-zoom-action]').forEach(function(b){b.addEventListener('click',function(){setZoom(b.dataset.zoomAction==='in'?scale+.25:b.dataset.zoomAction==='out'?scale-.25:1)})});qa('[data-pan-action]').forEach(function(b){b.addEventListener('click',function(){content.scrollBy({left:(b.dataset.panAction==='right'?1:-1)*Math.max(180,content.clientWidth*.6)})})});qa('[data-close]').forEach(function(b){b.addEventListener('click',function(){q('#'+b.dataset.close).close()})});q('.atlas-skip-diagrams').addEventListener('click',function(e){e.preventDefault();q('#atlas-diagrams').scrollIntoView();var b=q('.atlas-zoom');if(b)b.focus()})})();
</script>"""


def standalone(inner: str) -> str:
    fonts = "<style>@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400 600;font-display:swap;src:url('./fonts/jetbrains-mono-latin.woff2') format('woff2')}@font-face{font-family:'Space Grotesk';font-style:normal;font-weight:400 600;font-display:swap;src:url('./fonts/space-grotesk-latin.woff2') format('woff2')}</style>"
    script = "<script>(function(){var r=document.getElementById('atlas-root'),saved;try{saved=localStorage.getItem('atlas-theme')}catch(e){}r.dataset.theme=saved||(matchMedia('(prefers-color-scheme: dark)').matches?'dark':'light');var b=document.getElementById('atlas-theme');function themeState(){b.setAttribute('aria-pressed',String(r.dataset.theme==='dark'))}themeState();b.addEventListener('click',function(){r.dataset.theme=r.dataset.theme==='dark'?'light':'dark';themeState();try{localStorage.setItem('atlas-theme',r.dataset.theme)}catch(e){}});mermaid.initialize({startOnLoad:false,securityLevel:'loose',flowchart:{htmlLabels:true,useMaxWidth:true},sequence:{useMaxWidth:true}});mermaid.run({nodes:document.querySelectorAll('.mermaid')}).then(function(){setTimeout(function(){document.dispatchEvent(new Event('atlas:mermaid-rendered'))},0)})})();</script>"
    themed = (
        inner.rsplit("</div>", 1)[0]
        + '<button id="atlas-theme" type="button" aria-label="Toggle dark theme" aria-pressed="false">theme</button></div>'
        + inner.rsplit("</div>", 1)[1]
    )
    return f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{fonts}</head><body>{themed}<script src="./mermaid.min.js"></script>{script}</body></html>\n'


def write_if_changed(path: Path, content: str) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    changed = not path.exists() or path.read_text() != content
    if changed:
        path.write_text(content)
    return changed


def copy_if_changed(source: Path, target: Path) -> bool:
    target.parent.mkdir(parents=True, exist_ok=True)
    content = source.read_bytes()
    changed = not target.exists() or target.read_bytes() != content
    if changed:
        target.write_bytes(content)
    return changed


def main() -> int:
    docs = load()
    identities = load_identity_assets()
    evidence = stabilize_evidence(load_fixture_evidence(), embedded_evidence(OUT / "atlas.html"))
    inner = build(docs, evidence)
    vendored = REPO / "vendor" / "mermaid.min.js"
    if not vendored.exists():
        print("ERROR: vendor/mermaid.min.js missing; refusing standalone render", file=sys.stderr)
        return 1
    missing_fonts = [name for name in FONT_FILES if not (FONT_DIR / name).exists()]
    if missing_fonts:
        print(
            f"ERROR: missing standalone font asset(s): {', '.join(missing_fonts)}", file=sys.stderr
        )
        return 1
    OUT.mkdir(parents=True, exist_ok=True)
    for path, content, label in (
        (OUT / "atlas.html", inner, "artifact fragment"),
        (OUT / "site" / "index.html", standalone(inner), "standalone"),
        (OUT / "site" / "mermaid.min.js", vendored.read_text(), "mermaid runtime"),
    ):
        print(
            f"{'wrote' if write_if_changed(path, content) else 'unchanged'}: {path.relative_to(REPO)} [{label}]"
        )
    for name in FONT_FILES:
        target = OUT / "site" / "fonts" / name
        print(
            f"{'wrote' if copy_if_changed(FONT_DIR / name, target) else 'unchanged'}: {target.relative_to(REPO)} [font asset]"
        )
    # Mermaid sources reference page-scoped assets directly. Copy every asset
    # covered by a validated manifest, including files whose identity ID is
    # shared with another page.
    for manifest_path in sorted(ASSETS_ROOT.glob("*/manifest.yaml")):
        manifest = yaml.safe_load(manifest_path.read_text()) or {}
        for asset in manifest["assets"]:
            source = manifest_path.parent / asset["file"]
            relative = source.relative_to(ASSETS_ROOT)
            target = OUT / "site" / "assets" / relative
            print(
                f"{'wrote' if copy_if_changed(source, target) else 'unchanged'}: {target.relative_to(REPO)} [identity asset]"
            )
    for doc in docs:
        for screenshot in doc.get("screenshots", []):
            relative = Path(screenshot["src"].removeprefix("./"))
            source = SRC / relative
            if not source.is_file() or source.parent != SRC / "screenshots":
                raise ValueError(f"invalid local screenshot: {screenshot['src']}")
            target = OUT / "site" / relative
            print(
                f"{'wrote' if copy_if_changed(source, target) else 'unchanged'}: {target.relative_to(REPO)} [note screenshot]"
            )
    return 0


if __name__ == "__main__":
    sys.exit(main())
