#!/usr/bin/env python3
"""Render the static Atlas dashboard from Mermaid and sidecars only.

Committed fixture evidence is used for deterministic, offline public builds.
"""

from __future__ import annotations

import hashlib
import html
import json
import re
import sys
from datetime import datetime, timedelta, timezone
from pathlib import Path

import yaml

REPO = Path(__file__).resolve().parent.parent
SRC, META, OUT = REPO / "src", REPO / "src" / "meta", REPO / "out"
FONT_DIR = REPO / "vendor" / "fonts"
FONT_FILES = ("instrument-sans-var.woff2", "jetbrains-mono-latin.woff2")
ASSETS_ROOT = SRC / "assets"
IDENTITY_FALLBACKS = {"user": "👤", "agent": "🤖", "phone": "📱", "device": "🖥️"}

LAYERS = {"A": "Layer A", "B": "Layer B", "C": "Layer C"}
STACKS = (("foundations", "Foundations"), ("workloads", "Workloads"), ("operations", "Operations"))
LIFECYCLES = (
    "observed-live",
    "configured-inactive",
    "dormant",
    "external-unverified",
    "historical",
)
FRESHNESS_HOURS = 24
EVIDENCE_FIXTURE = REPO / "fixtures" / "demo" / "evidence.json"


def esc(value: object) -> str:
    return html.escape(str(value), quote=True)


def sha256(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest()


def load_identity_assets() -> dict[str, dict]:
    """Load all locally hashed, inert SVG identities without output-name collisions."""
    required = {
        "id",
        "file",
        "sha256",
        "source_url",
        "revision",
        "license",
        "attribution",
        "trademark",
        "fallback",
    }
    loaded: dict[str, dict] = {}
    output_hashes: dict[str, str] = {}
    for manifest_path in sorted(ASSETS_ROOT.glob("*/manifest.yaml")):
        asset_dir = manifest_path.parent
        manifest = yaml.safe_load(manifest_path.read_text()) or {}
        assets = manifest.get("assets")
        if not isinstance(assets, list):
            raise ValueError(f"{manifest_path}: asset manifest requires an assets list")
        for asset in assets:
            if not isinstance(asset, dict) or required - asset.keys():
                raise ValueError(f"{manifest_path}: asset manifest entry is incomplete")
            file = asset_dir / str(asset["file"])
            if file.parent != asset_dir or file.suffix.lower() != ".svg" or not file.is_file():
                raise ValueError(f"invalid local SVG asset: {asset.get('file')}")
            body = file.read_text(encoding="utf-8")
            digest = sha256(file)
            if digest != asset["sha256"]:
                raise ValueError(f"asset checksum mismatch: {file.name}")
            if re.search(
                r"<script|<foreignObject|\bon\w+\s*=|(?:href|src)\s*=\s*['\"](?:https?:|//|data:)",
                body,
                re.I,
            ):
                raise ValueError(f"unsafe SVG asset: {file.name}")
            if int(asset.get("sanitized_bytes", len(body.encode()))) > 100 * 1024:
                raise ValueError(f"SVG asset exceeds 100 KiB: {file.name}")
            identity = str(asset["id"])
            output_name = file.relative_to(ASSETS_ROOT).as_posix()
            if identity in loaded and loaded[identity]["sha256"] != digest:
                raise ValueError(f"conflicting identity asset: {identity}")
            if output_name in output_hashes and output_hashes[output_name] != digest:
                raise ValueError(f"conflicting output asset filename: {output_name}")
            output_hashes[output_name] = digest
            loaded[identity] = {
                **asset,
                "url": f"./assets/{output_name}",
                "output_name": output_name,
                "source_path": file,
            }
    return loaded


def identity_html(node: dict, identities: dict[str, dict]) -> str:
    identity = node.get("identity")
    if identity in identities:
        return f'<img class="atlas-identity" src="{esc(identities[identity]["url"])}" alt="" aria-hidden="true">'
    return f'<span class="atlas-identity-symbol" aria-hidden="true">{IDENTITY_FALLBACKS.get(identity, "🤖")}</span>'


def mermaid_node_ids(source: str) -> set[str]:
    return set(re.findall(r"(?m)^\s*([A-Za-z][\w-]*)\s*(?:\[|\()", source))


def mermaid_edges(source: str) -> list[str]:
    return re.findall(r"(?m)^\s*[A-Za-z][\w-]*\s*(?:-->|==>|-.->).*?$", source)


def slug(value: str) -> str:
    return "".join(ch.lower() if ch.isalnum() else "-" for ch in value).strip("-")


def stack_for(diagram_id: str) -> tuple[str, str]:
    number = int(diagram_id.split("-", 1)[0])
    return STACKS[0] if number <= 2 else STACKS[1] if number <= 8 else STACKS[2]


def capabilities(node: dict) -> list[str]:
    tags, kind = set(), node.get("kind")
    if kind in {"container", "unit", "timer", "path"}:
        tags.add("runtime")
    if kind == "container":
        tags.add("container")
    if kind in {"unit", "timer", "path"}:
        tags.add("systemd")
    if kind in {"volume", "device"} or node.get("mounts"):
        tags.add("storage")
    if kind == "external":
        tags.add("external")
    if node.get("listen") or node.get("ports") or node.get("serve_routes"):
        tags.add("ingress")
    if node.get("networks") or node.get("network_mode") or node.get("subnet"):
        tags.add("network")
    if node.get("class") == "warn":
        tags.add("degraded")
    return sorted(tags)


def path_values(value: object) -> list[str]:
    """Recursively extract string claims without inventing relationships."""
    if isinstance(value, str):
        return [value]
    if isinstance(value, dict):
        return [item for entry in value.values() for item in path_values(entry)]
    if isinstance(value, list):
        return [item for entry in value for item in path_values(entry)]
    return []


def metadata_for(node: dict, doc: dict, field: str) -> str:
    """Architecture metadata is explicit in sidecars, never inferred from mounts."""
    return str(node.get(field) or doc.get(field) or "unknown (not declared)")


def ingress_for(node: dict) -> list[str]:
    claims = path_values({key: node.get(key) for key in ("listen", "ports", "serve_routes")})
    return sorted(set(claims)) or ["none declared"]


def service_record(node: dict, doc: dict, ordinal: int) -> dict | None:
    name = node.get("name") or node.get("label")
    if not name or node.get("kind") not in {
        "container",
        "unit",
        "timer",
        "path",
        "volume",
        "device",
    }:
        return None
    repository = metadata_for(node, doc, "repository")
    own_storage = path_values({key: node.get(key) for key in ("path", "mounts")})
    related = sorted(set(own_storage)) or ["none declared"]
    return {
        "id": f"service-{slug(doc['id'])}-{slug(str(node['id']))}-{ordinal}",
        "name": str(name),
        "kind": str(node.get("kind")),
        "lifecycle": node["lifecycle"],
        "state": str(node.get("sub_state") or node.get("active_state") or node["lifecycle"]),
        "ingress": ingress_for(node),
        "repository": repository,
        "storage": related,
        "owner": metadata_for(node, doc, "owner"),
        "source": doc["source"],
        "diagram": doc["id"],
        "layer": doc["layer"],
        "stack_key": doc["stack_key"],
        "stack": doc["stack"],
        "capabilities": capabilities(node),
    }


def normalize(doc: dict, path: Path) -> dict:
    nodes = doc.get("nodes") or []
    if any(node.get("lifecycle") not in LIFECYCLES for node in nodes):
        raise ValueError(f"{path.name}: dashboard catalog requires valid node lifecycle values")
    diagram_id, layer = str(doc["id"]), str(doc.get("layer", ""))
    if layer not in LAYERS:
        raise ValueError(f"{path.name}: unknown layer {layer!r}")
    listed = doc.get("diagrams")
    pairs = (
        [(SRC / item["file"], item.get("topic", "")) for item in listed]
        if listed
        else [(SRC / f"{diagram_id}.mmd", "")]
    )
    missing = [str(source.relative_to(REPO)) for source, _ in pairs if not source.exists()]
    if missing:
        raise FileNotFoundError(f"{path.name}: missing Mermaid source: {', '.join(missing)}")
    stack_key, stack = stack_for(diagram_id)
    record = {
        "id": diagram_id,
        "anchor": f"atlas-diagram-{slug(diagram_id)}",
        "title": str(doc.get("title", diagram_id)),
        "layer": layer,
        "stack_key": stack_key,
        "stack": stack,
        "summary": str(doc.get("summary", "")).strip(),
        "audience": str(doc.get("audience", "")),
        "notes": [" ".join(str(note).split()) for note in doc.get("notes", [])],
        "screenshots": [
            {
                "src": str(item["src"]),
                "alt": str(item["alt"]),
                "caption": str(item.get("caption", "")),
            }
            for item in doc.get("screenshots", [])
        ],
        "repository": doc.get("repository"),
        "owner": doc.get("owner"),
        "source": f"src/meta/{path.name}",
        "bodies": [(topic, source.read_text().rstrip()) for source, topic in pairs],
        "nodes": nodes,
        "lifecycle": sorted({node["lifecycle"] for node in nodes}),
        "capabilities": sorted({tag for node in nodes for tag in capabilities(node)}),
    }
    record["services"] = [
        service
        for ordinal, node in enumerate(nodes)
        if (service := service_record(node, record, ordinal))
    ]
    return record


def load() -> list[dict]:
    return [
        normalize(yaml.safe_load(path.read_text()) or {}, path)
        for path in sorted(META.glob("*.yaml"))
    ]


def load_fixture_evidence() -> dict:
    """Load committed, deterministic public demonstration evidence."""
    try:
        evidence = json.loads(EVIDENCE_FIXTURE.read_text(encoding="utf-8"))
    except (OSError, json.JSONDecodeError) as error:
        raise ValueError(f"invalid evidence fixture: {EVIDENCE_FIXTURE}") from error
    required = {
        "captured_at",
        "host",
        "source_commit",
        "dirty",
        "gate",
        "findings",
        "freshness_hours",
        "evidence_sources",
        "stats",
    }
    if required - evidence.keys():
        raise ValueError("evidence fixture is incomplete")
    if not isinstance(evidence["stats"], list) or not isinstance(
        evidence["evidence_sources"], list
    ):
        raise ValueError("evidence fixture has invalid collections")
    return evidence


def evidence_fingerprint(evidence: dict) -> str:
    stable = {key: value for key, value in evidence.items() if key not in {"captured_at", "reused"}}
    return hashlib.sha256(
        json.dumps(stable, sort_keys=True, separators=(",", ":")).encode()
    ).hexdigest()


def embedded_evidence(path: Path) -> dict | None:
    """Read only the previous generated fragment's safe snapshot metadata."""
    try:
        match = re.search(r'id="atlas-root"[^>]*data-snapshot="([^"]+)"', path.read_text())
        return json.loads(html.unescape(match.group(1))) if match else None
    except (OSError, AttributeError, json.JSONDecodeError):
        return None


def stabilize_evidence(current: dict, previous: dict | None, now: datetime | None = None) -> dict:
    """Reuse an embedded timestamp only for equal, still-fresh evidence."""
    current = dict(current)
    fingerprint = evidence_fingerprint(current)
    if previous and previous.get("fingerprint") == fingerprint and not is_stale(previous, now):
        current["captured_at"] = previous["captured_at"]
    current["fingerprint"] = fingerprint
    return current


def is_stale(metadata: dict, now: datetime | None = None) -> bool:
    captured = datetime.fromisoformat(metadata["captured_at"].replace("Z", "+00:00"))
    return (now or datetime.now(timezone.utc)) > captured + timedelta(
        hours=int(metadata["freshness_hours"])
    )


def badge(value: str) -> str:
    return f'<span class="atlas-badge">{esc(value.replace("-", " "))}</span>'


