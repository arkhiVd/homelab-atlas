OVERVIEW = (
    "A self-hosted environment organized around authenticated remote access, containerized "
    "applications, synchronized storage, automation, observability, and agent-assisted "
    "workflows. Follow the diagrams from system context to individual application pipelines to "
    "see which clients open each dashboard, which services exchange data, and where durable "
    "state is kept."
)


def short_rev(text: str) -> str:
    return hashlib.sha256(text.encode()).hexdigest()[:7]


def stat_panel(value: object, label: str, state: str, hint: str) -> str:
    return (
        f'<section class="atlas-panel atlas-stat atlas-span-4" data-state="{esc(state)}">'
        f'<h3 class="atlas-panel-title">{esc(label)}</h3><p class="atlas-stat-value">'
        f'{esc(value)}</p><p class="atlas-stat-hint">{esc(hint)}</p></section>'
    )


def alert_item(state: str, title: str, detail: str) -> str:
    word = {"ok": "OK", "drift": "Drift", "crit": "Failing"}[state]
    return (
        f'<li class="atlas-alert" data-state="{esc(state)}"><span class="atlas-alert-state">'
        f'{word}</span><span class="atlas-alert-title">{esc(title)}</span>'
        f'<span class="atlas-alert-detail">{esc(detail)}</span></li>'
    )


def drawing_panel(doc: dict, body: dict, diagram_name: str) -> str:
    topic, source_file = body["topic"], body["file"]
    title = topic or "Diagram"
    label = f"{diagram_name}{': ' + topic if topic else ''}"
    if body["svg"]:
        drawing = body["svg"]
    else:
        participants = re.findall(
            r"^\s*%% atlas-participant (\w+) ([a-z0-9-]+)\s*$", body["text"], re.MULTILINE
        )
        assets = esc(json.dumps(dict(participants), separators=(",", ":"))) if participants else ""
        drawing = (
            f'<pre class="mermaid" data-atlas-participants="{assets}">{esc(body["text"])}</pre>'
        )
    return (
        f'<section class="atlas-panel atlas-span-24 atlas-drawing" data-engine="{body["engine"]}">'
        f'<header class="atlas-panel-head"><h3 class="atlas-panel-title">{esc(title)}</h3>'
        f'<code class="atlas-panel-file">{esc(source_file)}</code><span class="atlas-panel-tools">'
        f'<button type="button" class="atlas-tool atlas-actual" aria-pressed="false">Actual size'
        f'</button><button type="button" class="atlas-tool atlas-zoom" aria-label="Zoom {esc(label)}">'
        f'Zoom</button></span></header><div class="atlas-sheet">{drawing}</div></section>'
    )


def source_panel(doc: dict, evidence: dict) -> str:
    engines = {body["engine"] for body in doc["bodies"]}
    if engines == {"drafted"}:
        state, word = "ok", "drafted"
        check = f"geometry clean · {doc['drafted_nodes']} nodes · {doc['drafted_edges']} edges"
    elif "flowchart" in engines:
        state, word, check = "drift", "auto layout", "Mermaid layout, no geometry gate"
    else:
        state, word, check = "info", "sequence", "Mermaid sequence renderer"
    files = "".join(f"<code>{esc(body['file'])}</code>" for body in doc["bodies"])
    revision = " · ".join(body["rev"] for body in doc["bodies"])
    snapshot = f"{evidence['captured_at'][:10]} · {evidence['host']}"
    rows = (
        ("File", f'<span class="atlas-files">{files}<code>{esc(doc["source"])}</code></span>'),
        ("State", f'<span class="atlas-badge" data-state="{state}">{esc(word)}</span>'),
        ("Check", esc(check)),
        ("Revision", f"<code>{esc(revision)}</code> <span>{esc(evidence['source_commit'])}</span>"),
        ("Snapshot", f"<code>{esc(snapshot)}</code>"),
    )
    items = "".join(f"<dt>{label}</dt><dd>{value}</dd>" for label, value in rows)
    return (
        '<section class="atlas-panel atlas-span-8 atlas-source"><header class="atlas-panel-head">'
        f'<h3 class="atlas-panel-title">Source</h3></header><dl>{items}</dl></section>'
    )


def notes_panel(doc: dict) -> str:
    note_items = "".join(f"<li>{esc(note)}</li>" for note in doc["notes"])
    note_images = "".join(
        f'<figure><img src="{esc(item["src"])}" alt="{esc(item["alt"])}" loading="lazy">'
        f"<figcaption>{esc(item['caption'])}</figcaption></figure>"
        for item in doc.get("screenshots", [])
    )
    links = RESOURCE_LINKS.get(doc["id"], [])
    resources = (
        ""
        if not links
        else '<p class="atlas-resources"><strong>Sources:</strong> '
        + " · ".join(f'<a href="{esc(url)}">{esc(label)}</a>' for label, url in links)
        + "</p>"
    )
    body = f"<ul>{note_items}</ul>" if note_items else ""
    return (
        '<section class="atlas-panel atlas-span-16 atlas-notes" aria-label="Notes">'
        '<header class="atlas-panel-head"><h3 class="atlas-panel-title">Notes</h3></header>'
        f"<p>{esc(doc['summary'])}</p>{body}{note_images}{resources}</section>"
    )


def build(docs: list[dict], evidence: dict, now: datetime | None = None) -> str:
    stale = is_stale(evidence, now)
    meta = json.dumps(
        {key: value for key, value in evidence.items() if key not in {"stats", "reused"}},
        separators=(",", ":"),
    )
    bodies = [body for doc in docs for body in doc["bodies"]]
    flowcharts = [body for body in bodies if body["engine"] != "sequence"]
    drafted = [body for body in bodies if body["engine"] == "drafted"]
    pending = len(flowcharts) - len(drafted)
    components = sum(len(doc["nodes"]) for doc in docs)
    fixture_stats = "".join(
        stat_panel(value, label, "ok" if state == "ok" else "drift", "fixture evidence")
        for value, label, state in evidence["stats"][:2]
    )
    stats = (
        stat_panel(len(docs), "Diagram rows", "ok", f"{len(bodies)} source files")
        + stat_panel(components, "Sidecar nodes", "ok", "machine-checkable records")
        + stat_panel(
            f"{len(drafted)}/{len(flowcharts)}",
            "Drafted flowcharts",
            "ok" if not pending else "drift",
            "hand-placed, gutter-routed",
        )
        + stat_panel(
            evidence["gate"],
            "Fixture gate",
            "ok" if evidence["gate"] == "pass" and not stale else "drift",
            "stale fixture" if stale else "committed fixture",
        )
        + fixture_stats
    )
    alerts = [
        alert_item(
            "ok" if evidence["gate"] == "pass" else "crit",
            "Fixture gate",
            f"{evidence['gate']} · {evidence['findings']} findings · {evidence['host']}",
        )
    ]
    alerts += [
        alert_item("ok", f"Geometry · {doc['id']}", "no edge through a box, no label on a box")
        for doc in docs
        if any(body["engine"] == "drafted" for body in doc["bodies"])
    ]
    if pending:
        alerts.append(
            alert_item(
                "drift",
                "Auto-layout flowcharts",
                f"{pending} flowchart{'s' if pending != 1 else ''} still use Mermaid layout",
            )
        )
    if stale:
        alerts.append(alert_item("drift", "Fixture freshness", "snapshot older than its window"))
    jumps = "".join(
        f'<a class="atlas-jump" href="#{esc(doc["anchor"])}" data-target="{esc(doc["anchor"])}">'
        f"{esc(doc['id'].split('-', 1)[0])} {esc(doc['title'].split(' — ')[0])}</a>"
        for doc in docs
    )
    rows = []
    for doc in docs:
        heading, _, sub = doc["title"].partition(" — ")
        diagram_name = f"{heading}{': ' + sub if sub else ''}"
        panels = "".join(drawing_panel(doc, body, diagram_name) for body in doc["bodies"])
        rows.append(
            f'<section class="atlas-row atlas-diagram" id="{esc(doc["anchor"])}" '
            f'data-layer="{esc(doc["layer"])}" data-stack="{esc(doc["stack_key"])}">'
            f'<h2 class="atlas-row-head"><button type="button" class="atlas-row-toggle" '
            f'aria-expanded="true"><span class="atlas-row-id">{esc(doc["id"])}</span> '
            f'<span class="atlas-row-title">{esc(heading)}</span><span class="atlas-row-sub">'
            f"{esc(sub)}</span><span class=\"atlas-row-meta\">{esc(doc['stack'])} · "
            f"{len(doc['bodies']) + 2} panels</span></button></h2>"
            f'<div class="atlas-panels">{panels}{notes_panel(doc)}{source_panel(doc, evidence)}'
            "</div></section>"
        )
    snapshot = f"{evidence['captured_at'][:10]} · {evidence['host']}"
    return (
        f"<title>Homelab Atlas</title><style>{DASHBOARD_CSS}</style>"
        f'<div id="atlas-root" data-snapshot="{esc(meta)}">'
        '<a class="atlas-skip atlas-skip-diagrams" href="#atlas-diagrams">Skip to diagrams</a>'
        '<header class="atlas-top"><div class="atlas-bar">'
        '<nav class="atlas-crumbs" aria-label="Breadcrumb"><ol><li>Home</li><li>Dashboards</li>'
        '<li>Homelab</li><li aria-current="page"><h1>Atlas</h1></li></ol></nav>'
        '<label class="atlas-find"><span class="atlas-visually-hidden">Find diagrams</span>'
        '<input id="atlas-find" type="search" placeholder="Find diagrams, nodes, notes" '
        'autocomplete="off" aria-keyshortcuts="/"><kbd aria-hidden="true">/</kbd></label>'
        f'<span class="atlas-chip" title="Committed demonstration fixture">Snapshot '
        f"<code>{esc(snapshot)}</code></span>"
        '<button id="atlas-theme" class="atlas-tool" type="button" aria-label="Toggle dark theme" '
        'aria-pressed="false">Theme</button></div>'
        f'<nav class="atlas-jumps" aria-label="Diagram rows"><a class="atlas-jump" '
        f'href="#atlas-overview" data-target="atlas-overview">Overview</a>{jumps}</nav></header>'
        '<main class="atlas-main"><section class="atlas-row" id="atlas-overview">'
        '<h2 class="atlas-row-head"><span class="atlas-row-title">Overview</span>'
        '<span class="atlas-row-meta">fixture evidence, no live host data</span></h2>'
        f'<div class="atlas-panels">{stats}'
        '<section class="atlas-panel atlas-span-14 atlas-about"><header class="atlas-panel-head">'
        '<h3 class="atlas-panel-title">About this atlas</h3></header>'
        f"<p>{esc(OVERVIEW)}</p><p>Architecture diagrams, operating workflows, and upstream "
        "project references.</p></section>"
        '<section class="atlas-panel atlas-span-10 atlas-alerts"><header class="atlas-panel-head">'
        '<h3 class="atlas-panel-title">Findings and drift</h3></header>'
        f'<ul>{"".join(alerts)}</ul></section></div></section>'
        '<div id="atlas-diagrams" tabindex="-1"><p class="atlas-find-status" aria-live="polite">'
        f'</p>{"".join(rows)}</div></main>'
        '<dialog id="atlas-zoom" class="atlas-dialog" aria-label="Diagram zoom">'
        '<div class="atlas-zoom-bar"><button type="button" class="atlas-tool" '
        'data-close="atlas-zoom">Close</button><button type="button" class="atlas-tool" '
        'data-zoom-action="out" aria-label="Zoom out">−</button><button type="button" '
        'class="atlas-tool" data-zoom-action="reset">100%</button><button type="button" '
        'class="atlas-tool" data-zoom-action="in" aria-label="Zoom in">+</button>'
        '<span class="atlas-pan"><button type="button" class="atlas-tool" data-pan-action="left" '
        'aria-label="Pan left">←</button><button type="button" class="atlas-tool" '
        'data-pan-action="right" aria-label="Pan right">→</button></span></div>'
        '<div id="atlas-zoom-content"></div></dialog></div>' + DASHBOARD_SCRIPT
    )


PLANES = {
    # class: (light fill, light stroke, light text, dark fill, dark stroke, dark text)
    "host": ("#e8eaf0", "#4a5568", "#1a202c", "#23262d", "#9aa5b8", "#e6e8ec"),
    "ingress": ("#e0e7ff", "#4f46e5", "#1e1b4b", "#1e2040", "#818cf8", "#e0e7ff"),
    "media": ("#ffedd5", "#ea580c", "#431407", "#34230f", "#fb923c", "#ffedd5"),
    "data": ("#ccfbf1", "#0d9488", "#042f2e", "#0f2f2c", "#2dd4bf", "#ccfbf1"),
    "ai": ("#fae8ff", "#a21caf", "#4a044e", "#2f1634", "#e879f9", "#fae8ff"),
    "vpn": ("#dbeafe", "#2563eb", "#172554", "#13263f", "#60a5fa", "#dbeafe"),
    "secure": ("#fee2e2", "#dc2626", "#450a0a", "#3a1517", "#f87171", "#fee2e2"),
    "external": ("#f1f5f9", "#94a3b8", "#0f172a", "#1f232a", "#8b95a3", "#e2e8f0"),
    "warn": ("#fef9c3", "#ca8a04", "#422006", "#332b0c", "#facc15", "#fef9c3"),
    "none": ("#ffffff", "#8b939e", "#1f2328", "#1f2228", "#6e7681", "#d8d9da"),
}


def plane_css() -> str:
    light = "".join(
        f"#atlas-root .cls-{name}{{--pf:{v[0]};--ps:{v[1]};--pt:{v[2]}}}"
        for name, v in PLANES.items()
    )
    dark = "".join(
        f"#atlas-root[data-theme=dark] .cls-{name}{{--pf:{v[3]};--ps:{v[4]};--pt:{v[5]}}}"
        for name, v in PLANES.items()
    )
    return light + dark


