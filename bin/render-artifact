def standalone(inner: str) -> str:
    faces = "".join(
        f"@font-face{{font-family:'{family}';font-style:normal;font-weight:{weights};"
        f"font-display:swap;src:url('./fonts/{name}') format('woff2')}}"
        for family, weights, name in (
            ("Roboto", "100 900", "roboto-latin.woff2"),
            ("Roboto Mono", "100 700", "roboto-mono-latin.woff2"),
        )
    )
    page = (
        "html,body{margin:0;background:#f4f5f5}html[data-theme=dark],html[data-theme=dark] body"
        "{background:#111217}@media (prefers-color-scheme:dark){html:not([data-theme]),"
        "html:not([data-theme]) body{background:#111217}}"
    )
    script = (
        "<script>(function(){var r=document.getElementById('atlas-root'),d=document.documentElement,"
        "saved;try{saved=localStorage.getItem('atlas-theme')}catch(e){}function set(t){r.dataset.theme=t;"
        "d.dataset.theme=t;b.setAttribute('aria-pressed',String(t==='dark'))}var b=document."
        "getElementById('atlas-theme');set(saved||(matchMedia('(prefers-color-scheme: dark)').matches?"
        "'dark':'light'));b.addEventListener('click',function(){set(r.dataset.theme==='dark'?'light':"
        "'dark');try{localStorage.setItem('atlas-theme',r.dataset.theme)}catch(e){}});var nodes="
        "document.querySelectorAll('.mermaid');if(!nodes.length||!window.mermaid)return;"
        "mermaid.initialize({startOnLoad:false,securityLevel:'loose',fontFamily:'Roboto, system-ui, "
        "sans-serif',flowchart:{htmlLabels:true,useMaxWidth:true},sequence:{useMaxWidth:true}});"
        "mermaid.run({nodes:nodes}).then(function(){setTimeout(function(){document.dispatchEvent("
        "new Event('atlas:mermaid-rendered'))},0)})})();</script>"
    )
    return (
        '<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" '
        f'content="width=device-width, initial-scale=1"><link rel="icon" href="data:,"><style>{faces}{page}</style></head>'
        f'<body>{inner}<script src="./mermaid.min.js"></script>{script}</body></html>\n'
    )


def write_if_changed(path: Path, content: str) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    changed = not path.exists() or path.read_text() != content
    if changed:
        path.write_text(content)
    return changed


def copy_if_changed(source: Path, target: Path) -> bool:
    target.parent.mkdir(parents=True, exist_ok=True)
    content = source.read_bytes()
    changed = not target.exists() or target.read_bytes() != content
    if changed:
        target.write_bytes(content)
    return changed


def main() -> int:
    docs = load()
    evidence = stabilize_evidence(load_fixture_evidence(), embedded_evidence(OUT / "atlas.html"))
    inner = build(docs, evidence)
    vendored = REPO / "vendor" / "mermaid.min.js"
    if not vendored.exists():
        print("ERROR: vendor/mermaid.min.js missing; refusing standalone render", file=sys.stderr)
        return 1
    missing_fonts = [name for name in FONT_FILES if not (FONT_DIR / name).exists()]
    if missing_fonts:
        print(
            f"ERROR: missing standalone font asset(s): {', '.join(missing_fonts)}", file=sys.stderr
        )
        return 1
    OUT.mkdir(parents=True, exist_ok=True)
    for path, content, label in (
        (OUT / "atlas.html", inner, "artifact fragment"),
        (OUT / "site" / "index.html", standalone(inner), "standalone"),
        (OUT / "site" / "mermaid.min.js", vendored.read_text(), "mermaid runtime"),
    ):
        print(
            f"{'wrote' if write_if_changed(path, content) else 'unchanged'}: {path.relative_to(REPO)} [{label}]"
        )
    for name in FONT_FILES:
        target = OUT / "site" / "fonts" / name
        print(
            f"{'wrote' if copy_if_changed(FONT_DIR / name, target) else 'unchanged'}: {target.relative_to(REPO)} [font asset]"
        )
    # Mermaid sources reference page-scoped assets directly. Copy every asset
    # covered by a validated manifest, including files whose identity ID is
    # shared with another page.
    for manifest_path in sorted(ASSETS_ROOT.glob("*/manifest.yaml")):
        manifest = yaml.safe_load(manifest_path.read_text()) or {}
        for asset in manifest["assets"]:
            source = manifest_path.parent / asset["file"]
            relative = source.relative_to(ASSETS_ROOT)
            target = OUT / "site" / "assets" / relative
            print(
                f"{'wrote' if copy_if_changed(source, target) else 'unchanged'}: {target.relative_to(REPO)} [identity asset]"
            )
    for doc in docs:
        for screenshot in doc.get("screenshots", []):
            relative = Path(screenshot["src"].removeprefix("./"))
            source = SRC / relative
            if not source.is_file() or source.parent != SRC / "screenshots":
                raise ValueError(f"invalid local screenshot: {screenshot['src']}")
            target = OUT / "site" / relative
            print(
                f"{'wrote' if copy_if_changed(source, target) else 'unchanged'}: {target.relative_to(REPO)} [note screenshot]"
            )
    return 0


if __name__ == "__main__":
    sys.exit(main())
