def standalone(inner: str) -> str:
    fonts = "<style>@font-face{font-family:'Instrument Sans';font-style:normal;font-weight:400 700;font-display:swap;src:url('./fonts/instrument-sans-var.woff2') format('woff2')}@font-face{font-family:'JetBrains Mono';font-style:normal;font-weight:400 600;font-display:swap;src:url('./fonts/jetbrains-mono-latin.woff2') format('woff2')}</style>"
    script = """<script>(function(){var veil=document.getElementById('atlas-veil'),retry=document.getElementById('atlas-retry'),show=document.getElementById('atlas-show-text'),timer,settled=false,attempt=0;function current(generation){return generation===attempt}function arm(generation){clearTimeout(timer);timer=setTimeout(function(){fail(generation)},45000)}function reveal(generation){if(!current(generation))return;settled=true;clearTimeout(timer);veil.hidden=true}function showText(){attempt++;document.querySelectorAll('.atlas-sheet').forEach(function(sheet){var pre=document.createElement('pre');pre.className='atlas-source';pre.textContent=sheet.dataset.atlasSource||'Diagram source unavailable.';sheet.replaceChildren(pre)});settled=true;clearTimeout(timer);veil.hidden=true}function fail(generation){if(!current(generation)||settled)return;veil.querySelector('p').textContent='Homelab Atlas did not finish loading.';retry.hidden=false;show.hidden=false}function decorationAssets(){var urls=[].slice.call(document.querySelectorAll('.atlas-sheet svg image[href]')).map(function(image){return image.getAttribute('href')}).filter(Boolean);return Promise.all(urls.map(function(url){return new Promise(function(resolve){var image=new Image();image.onload=resolve;image.onerror=resolve;image.src=url})}))}function load(){var generation=++attempt;settled=false;arm(generation);retry.hidden=true;show.hidden=true;veil.querySelector('p').textContent='loading homelab atlas…';try{mermaid.initialize({startOnLoad:false,securityLevel:'loose',flowchart:{htmlLabels:true,useMaxWidth:true},sequence:{useMaxWidth:true}});mermaid.run({nodes:document.querySelectorAll('.mermaid')}).then(function(){if(!current(generation))return;setTimeout(function(){if(!current(generation))return;document.dispatchEvent(new Event('atlas:mermaid-rendered'));decorationAssets().then(function(){reveal(generation)},function(){fail(generation)})},0)},function(){fail(generation)})}catch(error){fail(generation)}}retry.addEventListener('click',load);show.addEventListener('click',showText);load()})();</script>"""
    veil = '<div id="atlas-veil" role="status" aria-live="polite"><p>loading homelab atlas…</p><button id="atlas-retry" type="button" hidden>Retry</button><button id="atlas-show-text" type="button" hidden>Show text</button></div><noscript><style>#atlas-veil{display:none}</style><p>JavaScript is off. The diagram source text and accompanying notes remain available below.</p></noscript>'
    return f'<!doctype html><html lang="en"><head><meta charset="utf-8"><meta name="viewport" content="width=device-width, initial-scale=1">{fonts}</head><body>{veil}{inner}<script src="./mermaid.min.js"></script>{script}</body></html>\n'


def write_if_changed(path: Path, content: str) -> bool:
    path.parent.mkdir(parents=True, exist_ok=True)
    changed = not path.exists() or path.read_text() != content
    if changed:
        path.write_text(content)
    return changed


def copy_if_changed(source: Path, target: Path) -> bool:
    target.parent.mkdir(parents=True, exist_ok=True)
    content = source.read_bytes()
    changed = not target.exists() or target.read_bytes() != content
    if changed:
        target.write_bytes(content)
    return changed


def main() -> int:
    docs = load()
    identities = load_identity_assets()
    evidence = stabilize_evidence(load_fixture_evidence(), embedded_evidence(OUT / "atlas.html"))
    inner = build(docs, evidence)
    vendored = REPO / "vendor" / "mermaid.min.js"
    if not vendored.exists():
        print("ERROR: vendor/mermaid.min.js missing; refusing standalone render", file=sys.stderr)
        return 1
    missing_fonts = [name for name in FONT_FILES if not (FONT_DIR / name).exists()]
    if missing_fonts:
        print(
            f"ERROR: missing standalone font asset(s): {', '.join(missing_fonts)}", file=sys.stderr
        )
        return 1
    OUT.mkdir(parents=True, exist_ok=True)
    for path, content, label in (
        (OUT / "atlas.html", inner, "artifact fragment"),
        (OUT / "site" / "index.html", standalone(inner), "standalone"),
        (OUT / "site" / "mermaid.min.js", vendored.read_text(), "mermaid runtime"),
    ):
        print(
            f"{'wrote' if write_if_changed(path, content) else 'unchanged'}: {path.relative_to(REPO)} [{label}]"
        )
    for name in FONT_FILES:
        target = OUT / "site" / "fonts" / name
        print(
            f"{'wrote' if copy_if_changed(FONT_DIR / name, target) else 'unchanged'}: {target.relative_to(REPO)} [font asset]"
        )
    # Mermaid sources reference page-scoped assets directly. Copy every asset
    # covered by a validated manifest, including files whose identity ID is
    # shared with another page.
    for manifest_path in sorted(ASSETS_ROOT.glob("*/manifest.yaml")):
        manifest = yaml.safe_load(manifest_path.read_text()) or {}
        for asset in manifest["assets"]:
            source = manifest_path.parent / asset["file"]
            relative = source.relative_to(ASSETS_ROOT)
            target = OUT / "site" / "assets" / relative
            print(
                f"{'wrote' if copy_if_changed(source, target) else 'unchanged'}: {target.relative_to(REPO)} [identity asset]"
            )
    for doc in docs:
        for screenshot in doc.get("screenshots", []):
            relative = Path(screenshot["src"].removeprefix("./"))
            source = SRC / relative
            if not source.is_file() or source.parent != SRC / "screenshots":
                raise ValueError(f"invalid local screenshot: {screenshot['src']}")
            target = OUT / "site" / relative
            print(
                f"{'wrote' if copy_if_changed(source, target) else 'unchanged'}: {target.relative_to(REPO)} [note screenshot]"
            )
    return 0


if __name__ == "__main__":
    sys.exit(main())
