    x_user --> sonobarr
    x_user --> musicportal
    sonobarr --> x_lastfm
    sonobarr ==>|"adds artists"| lidarr

    lidarr ==>|"wanted list"| soularr
    soularr <==>|"search and queue"| slskd
    slskd <==> x_soulseek
    slskd ==> v_slskd_dl
    v_slskd_dl ==>|"soularr imports"| lidarr
    lidarr ==>|"writes tagged files"| v_music

    musicportal ==> x_saavn
    musicportal ==>|"writes directly"| v_music

    v_music ==>|"read-only mount"| navidrome
    slskd -.->|"shares library read-only"| v_music

    x_user --> librarian
    librarian ==>|"deletes files"| v_music
    librarian ==>|"unmonitor albums,<br/>retire artists"| lidarr
    librarian -.->|"purges leftovers"| v_slskd_dl

    %% Non-traffic lane ordering between existing cards.
    v_slskd_dl ~~~ x_soulseek

